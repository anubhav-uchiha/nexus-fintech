{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "strict": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@generated/prisma/*": [
        "generated/prisma/*"
      ],
      "@nexus/common": [
        "libs/common/src"
      ],
      "@nexus/common/*": [
        "libs/common/src/*"
      ],
      "@nexus/config": [
        "libs/config/src"
      ],
      "@nexus/config/*": [
        "libs/config/src/*"
      ],
      "@nexus/database": [
        "libs/database/src"
      ],
      "@nexus/database/*": [
        "libs/database/src/*"
      ],
      "@nexus/logger": [
        "libs/logger/src"
      ],
      "@nexus/logger/*": [
        "libs/logger/src/*"
      ],
      "@nexus/messaging": [
        "libs/messaging/src"
      ],
      "@nexus/messaging/*": [
        "libs/messaging/src/*"
      ]
    }
  }
}