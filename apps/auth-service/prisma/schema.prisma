generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum LoginMethod {
  EMAIL
  USERNAME
  LOGIN_ID
  PHONENUMBER
}

enum RegistrationStep {
  ROLE_SELECTED
  PHONE_VERIFIED
  PAN_VERIFIED
  DETAILS_COMPLETED
  COMPLETED
}

enum AccountOnboardingStatus {
  CREDENTIALS_ISSUED
  PHONE_PENDING
  PAN_PENDING
  CREDENTIAL_CHANGE_REQUIRED
  COMPLETED
}

model Identity {
  id      String @id @default(uuid())
  loginId String @unique

  fullName String

  username    String @unique
  email       String @unique
  phoneNumber String @unique

  password String
  mpin     String

  aadhaarNumber String @unique
  panNumber     String @unique

  shopName    String
  shopAddress String
  shopCity    String
  shopState   String

  city    String
  state   String
  pincode String

  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isPanVerified   Boolean @default(false)

  preferredLoginMethod LoginMethod      @default(LOGIN_ID)
  registrationStep     RegistrationStep @default(ROLE_SELECTED)

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  mpinChangedAt     DateTime?

  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  
  lastLoginLatitude  Decimal? @db.Decimal(8, 6)
  lastLoginLongitude Decimal? @db.Decimal(9, 6)

  sessions            Session[]
  otp                 Otp[]
  passwordResetDrafts PasswordResetDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([email])
  @@index([username])
  @@index([phoneNumber])
  @@index([roleId])
  @@index([preferredLoginMethod])
  @@map("identities")
}

model SuperAdmin {
  id      String @id @default(uuid())
  loginId String @unique

  fullName String
  username String @unique
  email    String @unique

  phoneNumber String? @unique

  password String
  mpin     String

  aadhaarNumber String? @unique
  panNumber     String? @unique

  shopName    String?
  shopAddress String?
  shopCity    String?
  shopState   String?

  city    String
  state   String
  pincode String

  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isPanVerified   Boolean @default(false)

  preferredLoginMethod LoginMethod @default(LOGIN_ID)

  onboardingStatus AccountOnboardingStatus @default(CREDENTIALS_ISSUED)

  temporaryCredentialsExpireAt DateTime?

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  mpinChangedAt     DateTime?

  lastLoginLatitude  Decimal? @db.Decimal(8, 6)
  lastLoginLongitude Decimal? @db.Decimal(9, 6)

  roleId String
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  isPrimary Boolean @default(false)

  createdBySuperAdminId String?

  createdBySuperAdmin SuperAdmin? @relation("SuperAdminCreator",fields: [createdBySuperAdminId],references: [id],onDelete: SetNull)

  createdSuperAdmins SuperAdmin[] @relation("SuperAdminCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
  @@index([phoneNumber])
  @@index([roleId])
  @@index([preferredLoginMethod])
  @@index([onboardingStatus])
  @@index([createdBySuperAdminId])

  @@map("super_admins")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive Boolean @default(true)

  prefix String @unique @db.VarChar(10)
  lastLoginIdNumber Int @default(0)

  identities         Identity[]
  superAdmins        SuperAdmin[]
  registrationDrafts RegistrationDraft[]

  // rolePermissions RolePermission[]
  rolePackages RolePackage[]

  registrationPermissionsGranted RoleRegisterPermission[] @relation("RegistrarRole")
  registrationPermissionsReceived RoleRegisterPermission[] @relation("TargetRole")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id String @id @default(uuid())
  code String @unique
  name String
  description String?

  // isPackageControlled Boolean @default(false)
  isActive Boolean @default(true)

  // rolePermissions RolePermission[]
  packagePermissions PackagePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model Package {
  id String @id @default(uuid())
  code String @unique
  name String
  description String?

  price Decimal @default(0) @db.Decimal(18, 2)
  isActive Boolean @default(true)

  rolePackages RolePackage[]
  packagePermissions PackagePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packages")
}


model RolePackage {
  roleId String
  packageId String
  role Role @relation(fields: [roleId], references: [id],onDelete: Cascade)
  package Package @relation(fields: [packageId],references: [id],onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([roleId,packageId])
  @@index([packageId])
  @@map("role_packages")
}

model PackagePermission {
  packageId String
  permissionId String
  package Package @relation(fields: [packageId], references: [id],onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([packageId,permissionId])
  @@index([permissionId])
  @@map("package_permissions")
}

model RoleRegisterPermission {
  id String @id @default(uuid())
  registrarRoleId String
  targetRoleId String
  registrarRole Role @relation("RegistrarRole",fields: [registrarRoleId],references: [id],onDelete: Cascade)

  targetRole Role @relation("TargetRole", fields: [targetRoleId],references: [id],onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([registrarRoleId,targetRoleId])
  @@index([targetRoleId])
  @@map("role_register_permissions")
}

enum OtpType {
  PHONE
  EMAIL
}

enum OtpPurpose {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
  TRANSACTION
}

model Otp {
  id         String     @id @default(cuid())
  identityId String?
  identity   Identity?  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  type       OtpType
  purpose    OtpPurpose

  phoneNumber String?
  email       String?
  otpHash     String

  attempts Int @default(0)

  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([email])
  @@index([purpose])
}

model Session {
  id String @id @default(cuid())

  identityId String

  refreshToken String

  latitude           Decimal?  @db.Decimal(8, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  locationAccuracy   Float?
  locationCapturedAt DateTime?

  device    String?
  ipAddress String?
  userAgent String?

  expiresAt DateTime

  revoked Boolean @default(false)

  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

model RegistrationDraft {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  phoneNumber     String? @unique
  isPhoneVerified Boolean @default(false)

  panNumber     String? @unique
  isPanVerified Boolean @default(false)

  fullName String?

  username String? @unique

  email String? @unique

  aadhaarNumber String? @unique

  shopName String?

  shopAddress String?

  shopCity String?

  shopState String?

  city String?

  state String?

  pincode String?

  registrationStep RegistrationStep @default(ROLE_SELECTED)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([email])
  @@index([registrationStep])
  @@map("registration_drafts")
}

model PasswordResetDraft {
  id String @id @default(cuid())

  identityId  String
  identity    Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  otpVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([identityId])
  @@map("password_reset_drafts")
}



