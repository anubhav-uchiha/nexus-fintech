generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum LoginMethod {
  EMAIL
  USERNAME
  LOGIN_ID
  PHONENUMBER
}

enum RegistrationStep {
  ROLE_SELECTED
  PHONE_VERIFIED
  PAN_VERIFIED
  DETAILS_COMPLETED
  COMPLETED
}

model Identity {
  id      String @id @default(uuid())
  loginId String @unique

  fullName String

  username    String @unique
  email       String @unique
  phoneNumber String @unique

  password String
  mpin     String

  aadhaarNumber String @unique
  panNumber     String @unique

  shopName    String
  shopAddress String
  shopCity    String
  shopState   String

  city    String
  state   String
  pincode String

  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isPanVerified   Boolean @default(false)

  preferredLoginMethod LoginMethod      @default(LOGIN_ID)
  registrationStep     RegistrationStep @default(ROLE_SELECTED)

  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  roleId              String
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions            Session[]
  otp                 Otp[]
  passwordResetDrafts PasswordResetDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
  @@index([phoneNumber])
  @@index([roleId])
  @@index([preferredLoginMethod])
  @@map("identities")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  identities         Identity[]
  registrationDrafts RegistrationDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

enum OtpType {
  PHONE
  EMAIL
}

enum OtpPurpose {
  REGISTER
  LOGIN
  FORGOT_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
  TRANSACTION
}

model Otp {
  id         String     @id @default(cuid())
  identityId String?
  identity   Identity?  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  type       OtpType
  purpose    OtpPurpose

  phoneNumber String?
  email       String?
  otpHash     String

  attempts Int @default(0)

  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([email])
  @@index([purpose])
}

model Session {
  id String @id @default(cuid())

  identityId String

  refreshToken String

  device    String?
  ipAddress String?
  userAgent String?

  expiresAt DateTime

  revoked Boolean @default(false)

  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
}

model RegistrationDraft {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  phoneNumber     String? @unique
  isPhoneVerified Boolean @default(false)

  panNumber     String? @unique
  isPanVerified Boolean @default(false)

  fullName String?

  username String? @unique

  email String? @unique

  aadhaarNumber String? @unique

  shopName String?

  shopAddress String?

  shopCity String?

  shopState String?

  city String?

  state String?

  pincode String?

  registrationStep RegistrationStep @default(ROLE_SELECTED)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([phoneNumber])
  @@index([email])
  @@index([registrationStep])
  @@map("registration_drafts")
}

model PasswordResetDraft {
  id String @id @default(cuid())

  identityId  String
  identity    Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  otpVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([identityId])
  @@map("password_reset_drafts")
}
