generator client {
  provider = "prisma-client"
  output   = "../generated/kyc-prisma"
}

datasource db {
  provider = "postgresql"
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  SIGNATURE
  PAN_CARD
  AADHAAR_FRONT
  AADHAAR_BACK
  SHOP_FRONT
  BUSINESS_PROOF
  VIDEO_VERIFICATION
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Kyc {
  id          String                @id @default(uuid())
  identityId  String                @unique
  status      KycStatus             @default(PENDING)
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  remarks     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  documents   KycDocument[]
  video       KycVideoVerification?

  @@index([identityId])
  @@map("kyc")
}

model KycDocument {
  id               String         @id @default(uuid())
  kycId            String
  kyc              Kyc            @relation(fields: [kycId], references: [id], onDelete: Cascade)
  documentType     DocumentType
  documentNumber   String?
  originalFileName String
  storedFileName   String
  fileUrl          String
  mimeType         String
  fileSize         Int
  status           DocumentStatus @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  uploadedAt       DateTime       @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([kycId, documentType])
  @@index([kycId])
  @@index([documentType])
  @@map("kyc_documents")
}

model KycVideoVerification {
  id               String             @id @default(uuid())
  kycId            String             @unique
  kyc              Kyc                @relation(fields: [kycId], references: [id], onDelete: Cascade)
  originalFileName String
  storedFileName   String
  fileUrl          String
  mimeType         String
  fileSize         Int
  durationSeconds  Int?
  status           VerificationStatus @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  uploadedAt       DateTime           @default(now())
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("kyc_video_verifications")
}

model IdempotencyRecord {
  idempotencyKey String            @id
  identityId     String
  operation      String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  response       Json?
  statusCode     Int?
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  @@unique([identityId, operation, idempotencyKey])
  @@index([identityId])
  @@index([expiresAt])
  @@map("kyc_idempotency_records")
}
