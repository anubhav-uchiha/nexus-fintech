generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

enum CommissionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

model CommissionRule {
  id              String                   @id @default(uuid())
  ruleKey         String                   @unique @db.VarChar(64)
  serviceType     String
  operator        String?
  role            String
  commissionType  CommissionType
  commissionValue Decimal                  @db.Decimal(18, 4)
  minAmount       Decimal?                 @db.Decimal(18, 2)
  maxAmount       Decimal?                 @db.Decimal(18, 2)
  priority        Int                      @default(0)
  isActive        Boolean                  @default(true)
  commissions     Commission[]
  distributions   CommissionDistribution[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([serviceType])
  @@index([operator])
  @@index([role])
  @@index([isActive])
  @@index([priority])
  @@map("commission_rules")
}

model Commission {
  id                       String                              @id @default(uuid())
  referenceId              String                              @unique
  transactionId            String
  transactionReference     String?
  userId                   String
  role                     String
  serviceType              String
  operator                 String?
  transactionAmount        Decimal                             @db.Decimal(18, 2)
  commissionAmount         Decimal                             @db.Decimal(18, 2)
  commissionType           CommissionType
  ruleId                   String?
  rule                     CommissionRule?                     @relation(fields: [ruleId], references: [id])
  distributionTransactions CommissionDistributionTransaction[]
  status                   CommissionStatus                    @default(PENDING)
  idempotencyKey           String                              @unique
  metadata                 Json?
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt

  walletTransactionId String? @map("wallet_transaction_id")

  walletTransactionReference String? @map("wallet_transaction_reference")

  creditedAt DateTime? @map("credited_at")

  failureReason String? @map("failure_reason") @db.VarChar(500)

  reversedAt DateTime? @map("reversed_at")

  reversalReason String? @map("reversal_reason") @db.VarChar(500)

  @@index([transactionId])
  @@index([userId])
  @@index([role])
  @@index([transactionReference])
  @@index([serviceType])
  @@index([status])
  @@index([createdAt])
  @@map("commission")
}

model CommissionDistribution {
  id                       String                              @id @default(uuid())
  distributionKey          String                              @unique @db.VarChar(64)
  commissionRuleId         String
  commissionRule           CommissionRule                      @relation(fields: [commissionRuleId], references: [id], onDelete: Cascade)
  recipientRole            String
  distributionType         CommissionType
  distributionValue        Decimal                             @db.Decimal(18, 4)
  distributionTransactions CommissionDistributionTransaction[]
  priority                 Int                                 @default(0)
  isActive                 Boolean                             @default(true)
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt

  @@index([commissionRuleId])
  @@index([recipientRole])
  @@index([isActive])
  @@index([priority])
  @@map("commission_distributions")
}

model CommissionDistributionTransaction {
  id String @id @default(uuid())

  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id])

  distributionId String?

  distribution CommissionDistribution? @relation(fields: [distributionId], references: [id], onDelete: SetNull)

  sourceUserId String

  recipientUserId String
  recipientRole   String

  amount Decimal @db.Decimal(18, 2)

  walletType String @default("PROFIT")

  status CommissionStatus @default(PENDING)

  transactionId  String?
  idempotencyKey String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionReference String? @map("transaction_reference")

  creditedAt DateTime? @map("credited_at")

  failureReason String? @map("failure_reason") @db.VarChar(500)

  reversalTransactionId String? @map("reversal_transaction_id")

  reversalTransactionReference String? @map("reversal_transaction_reference")

  reversedAt DateTime? @map("reversed_at")

  reversalFailureReason String? @map("reversal_failure_reason") @db.VarChar(500)

  @@index([commissionId])
  @@index([distributionId])
  @@index([sourceUserId])
  @@index([transactionId])
  @@index([recipientUserId])
  @@index([recipientRole])
  @@index([status])
  @@map("commission_distribution_transactions")
}

model CommissionHierarchy {
  id String @id @default(uuid())

  parentUserId String
  parentRole   String

  childUserId String
  childRole   String

  /**
   * null = global/default hierarchy
   * Example:
   * RETAILER → DISTRIBUTOR
   * all AEPS services ke liye.
   */
  serviceType String?

  /**
   * Exact relationship identity.
   * Backend generated SHA256:
   * parent + child + service scope
   * Inactive same relationship ko
   * duplicate CREATE se protect karega.
   */
  relationshipKey String @unique @db.VarChar(64)

  /**
   * Only ACTIVE relationship ke liye set.
   * SHA256:
   * child + service scope
   * Guarantees:
   * one child
   * +
   * one scope
   * =
   * only one ACTIVE parent.
   * Inactive rows = null.
   * PostgreSQL multiple NULL allow karta hai,
   * jo yahan intentional hai.
   */
  activeScopeKey String? @unique @db.VarChar(64)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentUserId])
  @@index([parentRole])
  @@index([childUserId])
  @@index([childRole])
  @@index([serviceType])
  @@index([isActive])
  @@map("commission_hierarchies")
}
