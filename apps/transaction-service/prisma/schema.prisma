generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WalletType {
  MAIN
  AEPS
  PROFIT
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
}

model Transaction {
  id                 String            @id @default(uuid())
  referenceId        String            @unique
  transactionGroupId String?
  userId             String
  walletType         WalletType
  serviceType        String
  type               TransactionType
  amount             Decimal           @db.Decimal(18, 2)
  openingBalance     Decimal           @db.Decimal(18, 2)
  closingBalance     Decimal           @db.Decimal(18, 2)
  status             TransactionStatus @default(PENDING)
  description        String?
  externalReference  String?
  idempotencyKey     String
  metadata           Json?
  sequence           BigInt            @default(autoincrement())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([walletType])
  @@index([serviceType])
  @@index([status])
  @@index([createdAt])
  @@index([transactionGroupId])
  @@index([userId, walletType, createdAt])
  @@map("transactions")
}

enum ProviderTransactionStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  PENDING
  UNKNOWN
  REVERSED
}

enum ProviderSettlementStatus {
  NOT_REQUIRED
  PENDING
  RESERVED
  SETTLED
  COMPENSATED
  FAILED
  UNKNOWN
}

enum ProviderCommissionStatus {
  NOT_REQUIRED
  PENDING
  SETTLED
  FAILED
}

model ProviderTransaction {
  id String @id @default(uuid()) @db.Uuid

  /**
   * Hamara internal transaction reference.
   * Example:
   * PTXN-1787820000-ABC123
   */
  referenceId String @unique @map("reference_id")

  /**
   * Logged-in identity.
   */
  userId String @map("user_id")

  /**
   * Example:
   * AEPS
   * DMT
   * PAYOUT
   */
  serviceType String @map("service_type") @db.VarChar(50)

  /**
   * Example:
   * VIMOPAY
   * PAYSPRINT
   * SPICE_MONEY
   */
  provider String @db.VarChar(50)

  /**
   * Provider operation.
   * AEPS:
   * BE
   * MS
   * CW
   * AP
   * CD
   */
  operation String @db.VarChar(50)

  amount Decimal @default(0) @db.Decimal(18, 2)

  status ProviderTransactionStatus @default(INITIATED)

  /**
   * Financial requests ke liye API
   * Idempotency-Key.
   * BE/MS mein null ho sakti hai.
   */
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(100)

  /**
   * AEPS merchant profile reference.
   * Cross-microservice FK nahi hai.
   */
  merchantProfileId String? @map("merchant_profile_id") @db.Uuid

  /**
   * Provider merchant.
   * Example:
   * MER1234567
   */
  providerMerchantId String? @map("provider_merchant_id") @db.VarChar(100)

  /**
   * Backend generated merchantRefId.
   */
  providerMerchantRefId String? @map("provider_merchant_ref_id") @db.VarChar(100)

  /**
   * Provider transaction response txnRefId.
   */
  providerTxnRefId String? @map("provider_txn_ref_id") @db.VarChar(150)

  /**
   * NPCI reference.
   */
  rrn String? @db.VarChar(50)

  npciCode String? @map("npci_code") @db.VarChar(20)

  npciMessage String? @map("npci_message") @db.VarChar(250)

  providerStatusCode String? @map("provider_status_code") @db.VarChar(20)

  providerStatusMessage String? @map("provider_status_message") @db.VarChar(500)

  /**
   * Customer selected bank IIN.
   */
  bankIIN String? @map("bank_iin") @db.VarChar(30)

  /**
   * Full Aadhaar kabhi save nahi.
   */
  aadhaarLast4 String? @map("aadhaar_last4") @db.VarChar(4)

  /**
   * Safe provider/application metadata only.
   * pidData / OTP / full Aadhaar nahi.
   */
  metadata Json?

  providerCalledAt DateTime? @map("provider_called_at")

  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  needsReconciliation Boolean @default(false) @map("needs_reconciliation")

  reconciliationReason String? @map("reconciliation_reason") @db.VarChar(500)

  reconciledAt DateTime? @map("reconciled_at")

  reconciledBy String? @map("reconciled_by") @db.VarChar(100)

  reconciliationNote String?                      @map("reconciliation_note") @db.VarChar(500)
  reversal           ProviderTransactionReversal?
  reversedAt         DateTime?                    @map("reversed_at")

  settlementStatus ProviderSettlementStatus @default(NOT_REQUIRED) @map("settlement_status")

  settlementTransactionReference String? @map("settlement_transaction_reference") @db.VarChar(150)

  compensationTransactionReference String? @map("compensation_transaction_reference") @db.VarChar(150)

  settlementFailureReason String? @map("settlement_failure_reason") @db.VarChar(500)

  reservedAt DateTime? @map("reserved_at")

  settledAt DateTime? @map("settled_at")

  compensatedAt DateTime? @map("compensated_at")

  commissionStatus ProviderCommissionStatus @default(NOT_REQUIRED) @map("commission_status")

  commissionReferenceId String? @map("commission_reference_id") @db.VarChar(150)

  commissionWalletTransactionReference String? @map("commission_wallet_transaction_reference") @db.VarChar(150)

  commissionAmount Decimal? @map("commission_amount") @db.Decimal(18, 2)

  commissionFailureReason String? @map("commission_failure_reason") @db.VarChar(500)

  commissionSettledAt DateTime? @map("commission_settled_at")

  @@index([commissionStatus])
  @@index([settlementStatus])
  @@index([needsReconciliation, status])
  @@index([userId, createdAt])
  @@index([serviceType, provider])
  @@index([provider, operation])
  @@index([status])
  @@index([providerMerchantRefId])
  @@index([providerTxnRefId])
  @@index([rrn])
  @@map("provider_transactions")
}

enum ProviderTransactionReversalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  UNKNOWN
}

model ProviderTransactionReversal {
  id String @id @default(uuid()) @db.Uuid

  referenceId String @unique @map("reference_id") @db.VarChar(100)

  providerTransactionId String @unique @map("provider_transaction_id") @db.Uuid

  /**
   * Duplicate reversal request protection.
   */
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(100)

  amount Decimal @db.Decimal(18, 2)

  status ProviderTransactionReversalStatus @default(REQUESTED)

  reason String @db.VarChar(500)

  requestedBy String @map("requested_by") @db.VarChar(100)

  /**
   * Future compensation transaction reference.
   * Actual reversal complete hone se pehle
   * ye required hoga.
   */
  compensationReferenceId String? @map("compensation_reference_id") @db.VarChar(150)

  processingAt DateTime? @map("processing_at")

  completedAt DateTime? @map("completed_at")

  failedReason String? @map("failed_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  providerTransaction ProviderTransaction @relation(fields: [providerTransactionId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([requestedBy])
  @@index([createdAt])
  @@map("provider_transaction_reversals")
}
