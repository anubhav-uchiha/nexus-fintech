<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>UmiPay Account Credentials</title>
  </head>
  <body style='font-family: Arial, sans-serif; color: #1f2937;'>
    <div style='max-width: 600px; margin: 0 auto; padding: 24px;'>
      <h2>Welcome to UmiPay</h2>

      <p>Hello {{fullName}},</p>

      <p>Your UmiPay account has been created.</p>

      {{#if role}}
        <p><strong>Account role:</strong> {{role}}</p>
      {{/if}}

      <div style='background: #f3f4f6; padding: 16px; border-radius: 8px;'>
        <p><strong>Login ID:</strong> {{loginId}}</p>
        <p><strong>Temporary password:</strong> {{temporaryPassword}}</p>
        <p><strong>Temporary MPIN:</strong> {{temporaryMpin}}</p>
      </div>

      {{#if expiresAt}}
        <p>
          These temporary credentials expire at:
          <strong>{{expiresAt}}</strong>
        </p>
      {{/if}}

      <p>
        After signing in, complete phone verification, add your PAN, and change
        your temporary password and MPIN.
      </p>

      <p>Do not share these credentials with anyone.</p>
    </div>
  </body>
</html>