<html>

  <head>
    <meta charset='utf-8' />
    <title>Nexus Fintech</title>
  </head>

  <body
    style='font-family: Arial, Helvetica, sans-serif;background:#f5f5f5;padding:40px;'
  >

    <div
      style='background:white;padding:30px;border-radius:10px;max-width:600px;margin:auto;'
    >

      <h2 style='color:#2c3e50;'>
        Nexus Fintech
      </h2>

      <p>Hello,</p>

      <p>Your One-Time Password is:</p>

      <h1
        style='letter-spacing:8px;color:#1976d2;text-align:center;font-size:42px;'
      >
        {{otp}}
      </h1>

      <p>
        This OTP is valid for
        <b>{{expiry}}</b>
        minutes.
      </p>

      <hr />

      <small>
        If you didn't request this OTP, please ignore this email.
      </small>

    </div>

  </body>

</html>